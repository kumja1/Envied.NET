<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Envied.SourceGenerator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.1.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- We disable the automatic inclusion so that we can control exactly what gets packaged -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Authors>kumja1</Authors>
    <PackageId>Envied.NET.SourceGenerator</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Source generator for Envied.NET</Description>
    <PackageTags>envied;configuration;environment</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>Optimize generator performance</PackageReleaseNotes>
    <ProjectUrl>https://github.com/kumja1/Envied.NET</ProjectUrl>
    <RepositoryUrl>https://github.com/kumja1/Envied.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2025 kumja1</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet dependencies -->
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="PolySharp">
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SourceGenerator.Foundations" />
    <PackageReference Include="dotenv.net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="../Envied.Common/Envied.Common.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Envied.SourceGenerator.Common/Envied.SourceGenerator.Common.csproj" PrivateAssets="all" />
  </ItemGroup>



  <ItemGroup>
    <!-- Pack README.md as package documentation -->
    <None Update="README.md">
      <Pack>true</Pack>
      <PackagePath />
    </None>
  </ItemGroup>

  <ItemGroup>
    <SGF_EmbeddedAssembly Include="../Envied.Common/bin/$(Configuration)/netstandard2.0/*.dll" />
    <SGF_EmbeddedAssembly Include="../Envied.SourceGenerator.Common/bin/$(Configuration)/netstandard2.0/*.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Envied.Common/bin/$(Configuration)/netstandard2.0/Envied.Common.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="../Envied.SourceGenerator.Common/bin/$(Configuration)/netstandard2.0/Envied.SourceGenerator.Common.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(OutputPath)/$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
